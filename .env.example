# Set these in Netlify -> Site configuration -> Environment variables.
# For local testing with `netlify dev`, copy this file to .env and fill
# it in there. .env is gitignored, so never commit a real .env file.

# Optional. Extra origins allowed to call /api/audit, comma separated,
# once a custom domain is live. Netlify's own URL / DEPLOY_PRIME_URL /
# DEPLOY_URL are always allowed, so previews keep working untouched.
# e.g. https://firstfound.nl,https://www.firstfound.nl
ALLOWED_ORIGINS=

# No API keys are required. The site makes no LLM calls: /api/audit is
# plain HTTP fetches against the site being scanned. If a paid endpoint
# is ever added back, set a monthly spend limit on that provider first.
