# Set these in Netlify → Site configuration → Environment variables.
# For local testing with `netlify dev`, copy this file to .env and fill
# it in there — .env is gitignored. Never commit a real .env file.

# Required for /api/spotcheck (the one-time live AI check).
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Strongly recommended: in the Anthropic Console, set a monthly
# spend limit under Settings → Limits, so a bypass of the rate
# limiter can only ever cost a bounded amount.

# Optional. Comma-separated list of origins allowed to call /api/audit
# and /api/spotcheck, e.g. https://firstfound.nl,https://www.firstfound.nl
# Netlify's own URL / DEPLOY_PRIME_URL / DEPLOY_URL are always allowed,
# so previews and branch deploys work without setting this. Add your
# custom domain here once it's live.
ALLOWED_ORIGINS=
